+    def _read_postmortem_recording(self, filename, client_path, end_offset):
+        # Both paths come from the running game/server, never browser input.
+        if not filename:
+            raise ValueError("The server has no recording for this session.")
+        module_path = os.path.join(client_path, "ttyrec_transcript.py")
+        spec = importlib.util.spec_from_file_location("chili_ttyrec", module_path)
+        decoder = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(decoder)
+        # Server-owned recordings are streamed; they need not fit the browser's upload limit.
+        return decoder.read_recording(filename, byte_limit=None, end_offset=end_offset)
+
+    def _request_postmortem_recording(self, request_id):
+        if self.process:
+            self.process.flush_ttyrec()
+        filename = self.ttyrec_filename
+        if not filename:
+            lock = self._find_lock()
+            if lock:
+                basename = os.path.basename(lock).split(":", 1)[1]
+                filename = os.path.join(self.config_path("ttyrec_path"), basename)
+        # Snapshot the flushed boundary before the event loop can append more UI output.
+        try:
+            end_offset = os.path.getsize(filename) if filename else None
+        except OSError:
+            end_offset = None
+        loop = IOLoop.current()
+        key = (filename, self.client_path)
+        future = getattr(self, "_postmortem_recording_future", None)
+        if (getattr(self, "_postmortem_recording_key", None) != key or future is None
+                or (future.done() and future.exception() is not None)):
+            future = loop.run_in_executor(None, self._read_postmortem_recording,
+                                          filename, self.client_path, end_offset)
+            self._postmortem_recording_key = key
+            self._postmortem_recording_future = future
+        def completed(result):
+            try:
+                transcript = result.result()
+                self.send_to_user(self.username, "postmortem_recording",
+                                  request_id=request_id, transcript=transcript)
+            except Exception:
+                self.logger.warning("Could not prepare post-mortem ttyrec", exc_info=True)
+                self.send_to_user(self.username, "postmortem_recording", request_id=request_id,
+                                  error="Could not load this session's ttyrec. Ask the server administrator to check recording and decoder installation.")
+        loop.add_future(future, completed)
+
